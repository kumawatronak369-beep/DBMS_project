# Copy to collector/.env and edit. Never commit .env (it is git-ignored).
# Environment variables override values in this file.

# Where the FastAPI backend is running
COLLECTOR_BACKEND_URL=http://127.0.0.1:8000

# The collector API key of ONE node (seed.sql lists development-only keys). The backend derives the node from
# this key, so COLLECTOR_PROFILE below must be that node's profile.
COLLECTOR_API_KEY=nm_dev_lab-a_key

# lab-a | lab-b | lib-01 | admin-01  (which node's seeded devices to simulate)
COLLECTOR_PROFILE=lab-a

# Seconds between events, and how many to send (0 = keep running until Ctrl+C)
COLLECTOR_INTERVAL=2
COLLECTOR_COUNT=0

# Share (0-1) of events that deliberately repeat a very recent device + destination, to show the
# 30-second de-duplication in action
COLLECTOR_DUPLICATE_RATE=0.15

# Optional: request timeout (s), give up after N consecutive failures, fixed random seed
# COLLECTOR_TIMEOUT=5
# COLLECTOR_MAX_ERRORS=10
# COLLECTOR_SEED=42

# Real local collector (python collector.py local): TCP connections of THIS Windows computer only.
# Create the key with backend/create_collector_key.py and set COLLECTOR_API_KEY above (or in the environment).
# COLLECTOR_DEVICE_ID names this computer (default: its host name). COLLECTOR_DEVICE_IP is used only by local-dns.
# COLLECTOR_DEVICE_ID=MY-LAPTOP
# COLLECTOR_DEVICE_IP=192.168.1.3
