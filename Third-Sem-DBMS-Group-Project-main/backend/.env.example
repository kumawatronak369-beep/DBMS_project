# Copy to .env and fill in real values. Never commit .env.

# Connection target WITHOUT credentials (network_monitor is created by database/schema.sql)
DATABASE_URL=mysql+pymysql://localhost:3306/network_monitor
DATABASE_USERNAME=root
DATABASE_PASSWORD=change-me

# Signs login tokens. REQUIRED: the API refuses to start unless this is at least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Optional
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12   # 10-15
# Interactive docs at /docs, /redoc and /openapi.json. Set to false on a deployed system.
ENABLE_API_DOCS=true

# (The collector simulator has its own settings in collector/.env, see collector/.env.example.)

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
